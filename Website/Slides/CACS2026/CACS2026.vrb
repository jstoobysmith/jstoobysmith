    (hsub : x ∈ ofFinset I.allowedBarFiveCharges I.allowedTenCharges) :
    x ∈ viableCharges I ↔
      AllowsTerm x topYukawa ∧
      ¬ IsPhenoConstrained x ∧
      ¬ YukawaGeneratesDangerousAtLevel x 1 ∧
